{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>metio/renovate-config"
  ],
  "packageRules": [
    {
      "allowedVersions": "<5",
      "description": "Hold vitest on 4.x while browser mode rescales every screenshot. Under 5 a story captured by the storybook project comes out 1.25x larger — 960x551 becomes 1200x688, the same content at a higher scale — so all 296 committed baselines in app/**/__story-shots__ fail on their dimensions before a pixel is compared. The scale is identical on this machine and on a runner, so it is reproducible rather than local, but neither screenshotOptions.scale nor a pinned deviceScaleFactor in contextOptions moves it, and vitest carries open browser-mode viewport/zoom regressions (vitest-dev/vitest#11687, #11250) that make the old scale likelier to return than to stay. Rewriting every baseline is the alternative and it would be undone by the fix. The four packages move together because @vitest/browser pins vitest to its own exact version. Drop this rule when a vitest 5 release captures at the scale the baselines hold, or when the decision is taken to recut them.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vitest",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-istanbul"
      ]
    },
    {
      "allowedVersions": "<7",
      "description": "Hold typescript on 6.x until dependency-cruiser supports 7. depcruise reads .ts and .tsx only through a TypeScript compiler inside its peer range (>=2.0.0 <7.0.0); outside it there is no failure to notice — it registers no scannable extensions, enumerates nothing, finds no violations in the nothing it enumerated and exits 0. That is how `npm run arch` stayed green from the 7.0.0 bump on 2026-08-02 until 2026-08-19, with ui-is-pure, stores-point-down and adapters-only-at-the-composition-root all evaluated over an empty set. Minor and patch updates inside 6.x still flow. Drop this rule when dependency-cruiser ships TS 7 support — by its own message that waits on the TS 7 API being published and stable, not on a particular TypeScript release. dev/check-architecture.mjs now fails when a cruise reaches too little of app/ or core/, so removing this rule too early makes the gate say so instead of passing over nothing.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ]
    }
  ]
}
